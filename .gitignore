data/*.db
data/*.sqlite
data/*.sqlite3
data/**/*.duckdb.wal
data/**/*.db.wal

# Local state leftovers (state/* already ignored; explicit WAL/out patterns)
state/**/*.wal
state/**/*.out

# ---------------------------------------------------------------------------
# Misplaced root one-off tests (prefer test/ — ASREF-G090 / ASREF-013 / ASREF-014)
# Do not add new root-level test_*.py. Historical tracked files may remain until
# an operator moves them under test/ and untracks the root copies:
#   git mv test_dashboard_sdk.py test/  # when path scope allows
#   git mv test_mcp_jsonrpc_conformance.py test/
# ---------------------------------------------------------------------------
/test_dashboard_sdk.py
/test_mcp_jsonrpc_conformance.py

