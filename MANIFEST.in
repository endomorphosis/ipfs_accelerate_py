include LICENSE
include README.md
include pyproject.toml
include requirements.txt
include requirements-proof-reuse.txt
include docs/guides/TEST_PROOF_REUSE_DEPENDENCY_PROVISIONING.md
include WEBGPU_WEBNN_MIGRATION_PLAN.md

recursive-include ipfs_accelerate_py *.py
include ipfs_accelerate_py/agent_supervisor/semantic_state/schemas/*.json
recursive-include ipfs_accelerate_py/agent_supervisor/task_sources/sql *.sql
include scripts/__init__.py
recursive-include scripts/shared *.py
recursive-include mcp *.py
recursive-include docs *.md *.html *.py
include ipfs_accelerate_py/api_backends/model_list/.gitkeep
include github_autoscaler.py
include docker_startup_check.py
include docker-entrypoint.sh

exclude benchmarks/*.txt
exclude benchmarks/*.json
exclude test/*.txt
exclude test/*.json

global-exclude __pycache__
global-exclude *.py[cod]
global-exclude *.so
global-exclude .git*
global-exclude .DS_Store

# PCPR-052: clean installs must not require sibling source trees or
# recursive submodule checkouts. These directories are gitlinks or
# development-checkout clutter and are not distribution members.
prune ipfs_datasets_py
prune ipfs_kit_py
prune ipfs_model_manager_py
prune ipfs_transformers_py
prune .tools
prune docs/fastmcp
prune docs/mcp-python-sdk
prune ipfs_accelerate_py/mcplusplus
prune test/doc-builder
prune test/huggingface_doc_builder
prune test/huggingface_transformers
