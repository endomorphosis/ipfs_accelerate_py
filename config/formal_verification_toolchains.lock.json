{
  "schema_version": "offline-toolchain-lock/v1",
  "interface": "OfflineToolchainLock@1",
  "packaging_gate_interface": "FormalVerificationPackagingGate@1",
  "goal_id": "FVT-G010",
  "task_id": "FVT-006",
  "program": "formal-verification-tactician/readiness",
  "description": "Hermetic offline lock of external formal-verification tool identities. Verification and packaging gates must bind exact pinned versions, detect shim/toolchain mismatches, and never install, download, or open network sockets during offline verification.",
  "binding_mode": "declarative_pin_inventory",
  "registry_interface": "VerificationToolchainRegistry@1",
  "install_policy": {
    "schema_version": "verification-toolchain-install-policy/v1",
    "never_on_import": true,
    "never_on_capability_discovery": true,
    "requires_explicit_yes": true,
    "requires_pin_or_declared_gap": true,
    "requires_checksum_for_managed_artifacts": true,
    "forbid_system_package_mutation_in_tests": true,
    "forbid_curl_pipe_shell": true
  },
  "offline_verification_policy": {
    "forbid_install": true,
    "forbid_download": true,
    "forbid_network": true,
    "forbid_curl_pipe_shell": true,
    "forbid_system_package_mutation": true,
    "require_exact_pin_match_for_production_certification": true,
    "path_presence_is_not_usability": true,
    "shim_toolchain_mismatch_fails_closed": true
  },
  "detection_rules": {
    "lean_shim_toolchain_mismatch": {
      "id": "lean_shim_toolchain_mismatch",
      "severity": "high",
      "description": "Elan/default selection names a Lean toolchain that is not fully installed offline, so lean/lake on PATH can still trigger a network download during reconstruction.",
      "inputs": [
        "selected_toolchain",
        "installed_toolchains",
        "lean_executable_path",
        "lean_version_string"
      ],
      "predicate": "selected_toolchain is non-empty AND selected_toolchain not in installed_toolchains",
      "effect": {
        "usable": false,
        "production_certified": false,
        "offline_verification": "fail_closed_without_install_or_fetch"
      }
    },
    "locked_version_mismatch": {
      "id": "locked_version_mismatch",
      "severity": "high",
      "description": "Observed tool version string does not contain the locked pin version. Hermetic offline certification requires an exact pin match.",
      "inputs": [
        "locked_version",
        "observed_version_string"
      ],
      "predicate": "locked_version not reflected in observed_version_string",
      "effect": {
        "production_certified": false,
        "offline_verification": "fail_closed_without_upgrade_or_download"
      }
    }
  },
