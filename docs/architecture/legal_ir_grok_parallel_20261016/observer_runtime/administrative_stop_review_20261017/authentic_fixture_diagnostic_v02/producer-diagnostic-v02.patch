+# Diagnostic state never includes audit arguments, command text, addresses,
+# environment values, local variables, source text, or exception reprs.
+# It records only the first and last blocked event, a bounded frame crosswalk,
+# and an exact exception-object join when main catches the propagated refusal.
+_DIAGNOSTIC_REPO = None
+_DIAGNOSTIC_STAGE = "before_native_imports"
+_DIAGNOSTIC_BLOCK_COUNT = 0
+_DIAGNOSTIC_FIRST = None
+_DIAGNOSTIC_LAST = None
+_DIAGNOSTIC_LAST_ERROR = None
+
+
+def diagnostic_frame(frame):
+    filename = frame.f_code.co_filename
+    qualified_prefix = (_DIAGNOSTIC_REPO + "/") if _DIAGNOSTIC_REPO else None
+    stdlib_prefix = str(Path(os.__file__).parent) + "/"
+    if qualified_prefix and filename.startswith(qualified_prefix):
+        source_root, name = "qualified_product", filename[len(qualified_prefix):]
+    elif filename == __file__:
+        source_root, name = "diagnostic_producer", Path(__file__).name
+    elif filename.startswith(stdlib_prefix):
+        source_root, name = "python_stdlib", filename[len(stdlib_prefix):]
+    elif filename.startswith("<") and filename.endswith(">") and len(filename) <= 128:
+        source_root, name = "python_pseudo_filename", filename
+    else:
+        # An unregistered filename is identified by hash, without exposing
+        # an ambient pathname. Parent can join it to its admitted source map.
+        source_root, name = "outside_known_source_roots", None
+    if name is not None and (len(name) > 768 or any(ord(c) < 32 or ord(c) > 126 for c in name)):
+        name = None
+    function = frame.f_code.co_name
+    if len(function) > 128 or any(ord(c) < 32 or ord(c) > 126 for c in function):
+        function = "<unrepresentable-function-name>"
+    return {"source_root": source_root, "filename": name,
+            "filename_sha256": hashlib.sha256(filename.encode("utf-8", "replace")).hexdigest(),
+            "line": frame.f_lineno, "function": function}
+
+
+def refused_dispatch(event, message):
