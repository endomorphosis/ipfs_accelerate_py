+    frames = []
+    frame = sys._getframe(2)
+    try:
+        while frame is not None and len(frames) < 24:
+            frames.append(diagnostic_frame(frame))
+            frame = frame.f_back
+        truncated = frame is not None
+    finally:
+        del frame
+    diagnostic = {"schema": "authentic-fixture-denied-dispatch-observation@2",
+        "event": event, "stage": _DIAGNOSTIC_STAGE,
+        "blocked_event_ordinal": _DIAGNOSTIC_BLOCK_COUNT,
+        "frames": frames, "frames_truncated": truncated,
+        "audit_arguments_exported": False, "environment_exported": False,
+        "local_variables_exported": False, "dispatch_authorized": False}
+    error = RuntimeError(message)
+    if _DIAGNOSTIC_FIRST is None:
+        _DIAGNOSTIC_FIRST = diagnostic
+    _DIAGNOSTIC_LAST = diagnostic
+    _DIAGNOSTIC_LAST_ERROR = error
+    raise error
+
