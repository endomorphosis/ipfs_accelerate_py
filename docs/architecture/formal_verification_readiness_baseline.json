      "effect_on_status": {
        "installed": "may remain true when a partial shim or alternate toolchain is present",
        "usable": false,
        "production_certified": false
      },
      "audit_observation": "Audit host selected Lean 4.32.2 via elan while only toolchains through 4.32.1 were offline-installed; reconstruction attempts attempted a network download and failed. This class of mismatch must fail closed without install/fetch."
