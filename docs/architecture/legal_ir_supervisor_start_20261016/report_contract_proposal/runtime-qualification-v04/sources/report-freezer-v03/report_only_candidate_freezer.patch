+ANCHOR = """import os,resource,select
+for k,v in ((resource.RLIMIT_CPU,30),(resource.RLIMIT_AS,268435456),(resource.RLIMIT_FSIZE,16777216),(resource.RLIMIT_NOFILE,64)):
+ resource.setrlimit(k,(v,v))
