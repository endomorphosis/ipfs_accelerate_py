  "validation": [
    "python3 -m pytest -q test/api/agent_supervisor/efficiency_state_hardening/test_cross_repository_contracts.py"
  ],
  "vectors": [
    {
      "expect": "accept",
      "id": "canonical_bytes_and_cid_equality",
      "proof": "Datasets and Kit CIDv1 of the same raw bytes are equal, Kit get returns those exact bytes, and Accelerate verifies both identities without reminting pack_cid."
    },
    {
      "expect": "reject",
      "id": "unknown_fields",
      "proof": "Closed Datasets envelopes, Kit store records, and installed Kit contract vectors reject unknown fields."
    },
    {
      "expect": "reject",
      "id": "numeric_bounds",
      "proof": "Datasets JSON-unsafe integer bounds and Kit negative generation or byte_length fail closed."
    },
    {
      "expect": "reject",
      "id": "stale_identities",
      "proof": "Exact tree, objective, policy, interface, toolchain, and environment mismatches are rejected and cannot be reused."
    },
    {
      "expect": "reject",
      "id": "missing_dependencies",
      "proof": "Unresolved dependency CIDs, unnamed missing references, incomplete packs, and independently installed packages that lack a required sibling authority fail closed."
    },
    {
      "expect": "accept",
      "id": "authority_boundaries",
      "proof": "Independent Datasets, Kit, and Accelerate installs prove each repository's owns and must_not_own boundary."
    },
    {
      "expect": "reject",
      "id": "no_sibling_source_tree_test_imports",
      "proof": "Isolated installs exclude sibling tests/ trees; production modules and this suite do not import uninstalled source-tree tests."
    },
    {
      "expect": "accept",
      "id": "independent_current_head_installation",
      "proof": "Each current-head package tree is copied independently into a non-editable site-packages without sibling tests, at peelable commits/trees that have the planning snapshots as ancestors."
    }
  ]
