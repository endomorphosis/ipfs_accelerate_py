  "substantive_conclusions": [
    {
      "finding": "Shared policy is explicit and immutable under ordinary assignment; public operations revalidate canonical profile and protected-line tuples. Inventory and worker constructors reject protection references outside their admitted regular Python populations. Regular .py and .pyi remain Python-eligible even under identity@1. Caller file-kind classification in the pure resolver itself grants no admission.",
      "id": "explicit_shared_policy_and_canonical_scope",
      "references": [
        "ipfs_accelerate_py/agent_supervisor/runtime/source_view_policy.py",
        "ipfs_accelerate_py/agent_supervisor/runtime/repository_code_view_inventory.py:172-175",
        "ipfs_accelerate_py/agent_supervisor/runtime/worker_source_views.py:131-140",
        "ipfs_accelerate_py/agent_supervisor/runtime/worker_source_views.py:70-111"
      ]
    },
    {
      "finding": "The codec and pure mapper are byte-identical to the accelerator baseline. Legacy inventory roots retain schema@1, the same codec projection arguments and closed field set; shared roots use schema@2 and a separately compared complete policy binding. No import or comment was added to the self-hashed codec. Historical replay still requires the matching Python/stdlib codec binding.",
      "id": "historical_codec_identity_and_replay",
      "references": [
        "ipfs_accelerate_py/agent_supervisor/runtime/repository_code_view_inventory.py:178-225",
        "ipfs_accelerate_py/agent_supervisor/runtime/reversible_source_view.py:73-81",
        "ipfs_accelerate_py/agent_supervisor/runtime/reversible_source_view.py:236-278"
      ]
    },
    {
      "finding": "Shared baseline admission@2 binds the full policy, resolver hash and codec identity. Working admission@2 inherits it and generation derivation includes baseline scope. Binding checks compare current policy and canonical retained binding; policy changes invalidate existing custody. Working pages retain the policy SHA through inherited metadata and use page@4; baseline shared pages use page@3 and shared discovery uses discovery@2.",
      "id": "working_generation_and_policy_binding",
      "references": [
        "ipfs_accelerate_py/agent_supervisor/runtime/worker_source_views.py:149-209",
        "ipfs_accelerate_py/agent_supervisor/runtime/worker_source_views.py:490-530"
      ]
    },
    {
      "finding": "The existing client and broker are unchanged. Shared host pages have distinct closed shapes and schema@3/@4; existing wire validation accepts only legacy baseline@1/working@2. No CLI, broker descriptor or production router opt-in for shared policy is added by this increment.",
      "id": "host_only_wire_boundary",
      "references": [
        "ipfs_accelerate_py/agent_supervisor/runtime/worker_source_client.py:145-182",
        "test/api/test_shared_source_view_policy.py:399-410"
      ]
    },
    {
      "finding": "The host edit adapter obtains a checked generation projection from its admitted views rather than independently selecting filename suffixes. Shared application@2 records the policy binding SHA. The unchanged pure mapper carries the original protected-line tuple into candidate replay; protection preserves displayed text and physical-line anchors, allows same-line edits, and conservatively refuses LF-changing edits when any caller lines are declared.",
      "id": "edit_recipe_and_protected_line_semantics",
      "references": [
        "ipfs_accelerate_py/agent_supervisor/runtime/source_view_edit_candidate.py:98-119",
        "ipfs_accelerate_py/agent_supervisor/runtime/source_view_edit_candidate.py:154-169",
        "ipfs_accelerate_py/agent_supervisor/runtime/source_view_edits.py:124-147"
      ]
    }
  ]
