  "resolved_review_findings": [
    {
      "id": "coherently_changed_cached_source_and_view",
      "initial_issue": "The first working_projection implementation compared the rebuilt projection only with its cached view tuple; coherent changes to cached original and cached view could return a projection not bound to the retained generation hashes.",
      "references": [
        "ipfs_accelerate_py/agent_supervisor/runtime/worker_source_views.py:272-300",
        "test/api/test_shared_source_view_policy.py:319-332"
      ],
      "resolution": "working_projection now validates the entire copied original population, exact byte types and every source SHA against candidate hashes before projection, then checks unchanged cached originals after the final source verification. Refusal invalidates the working cache and continuations.",
      "status": "fixed_and_statically_rechecked"
    },
    {
      "id": "default_equal_profile_subclass",
      "initial_issue": "Shared-mode conflict guards originally compared the legacy profile with the default before overwriting it, allowing equality-compatible string subclasses.",
      "references": [
        "ipfs_accelerate_py/agent_supervisor/runtime/repository_code_view_inventory.py:111-117",
        "ipfs_accelerate_py/agent_supervisor/runtime/worker_source_views.py:131-136",
        "test/api/test_shared_source_view_policy.py:214-224"
      ],
      "resolution": "Both inventory and worker shared-mode guards require type(profile) is str as well as the exact default value before accepting the policy.",
      "status": "fixed_and_statically_rechecked"
    },
    {
      "id": "unconditional_runtime_import_dependency",
      "initial_issue": "The new module is unconditionally imported by worker_source_views, so even legacy source-view mode requires its presence. The initial worker capability source list did not pin it.",
      "references": [
        "benchmarks/agent_supervisor/container_coding/terminal_worker_capability.py:33-41",
        "benchmarks/agent_supervisor/container_coding/test_terminal_worker_capability.py:65-102",
        "benchmarks/agent_supervisor/container_coding/terminal_deployment.py:843-862",
        "benchmarks/agent_supervisor/container_coding/test_terminal_deployment.py:41-54"
      ],
      "resolution": "terminal_worker_capability SOURCE_PATHS now includes source_view_policy. Its exact expected-set assertion and missing/stale/copied-feature controls include the helper. Recursive runtime archive enumeration already includes regular .py files; no separate packaging pipeline was introduced.",
      "status": "fixed_and_statically_rechecked"
    }
  ],
