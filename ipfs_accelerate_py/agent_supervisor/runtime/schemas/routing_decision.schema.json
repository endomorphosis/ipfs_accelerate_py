{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ipfs_accelerate_py/agent-supervisor/aseh-routing-decision@1",
  "title": "ASEH routing decision and closed route receipt",
  "description": "Closed route receipt for one receipt-to-human traversal. Missing telemetry remains unavailable. Requested rates are never computed by imputing a missing or zero denominator. Receipts report routing observations only and cannot validate patches or promote policy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "identity",
    "stages_run",
    "stages_skipped_and_reason",
    "decisive_evidence",
    "escalation_reason",
    "selected_executor",
    "actual_resource_use",
    "final_outcome",
    "unnecessary_escalation",
    "question_closure",
    "metrics",
    "authority",
    "explicit_unavailable_fields",
    "receipt_cid"
  ],
  "properties": {
    "schema": {
      "const": "ipfs_accelerate_py/agent-supervisor/aseh-routing-decision@1"
    },
    "schema_version": { "const": 1 },
    "identity": { "$ref": "#/$defs/identity" },
    "stages_run": {
      "type": "array",
      "minItems": 1,
      "maxItems": 9,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/stageRun" }
    },
    "stages_skipped_and_reason": {
      "type": "array",
      "minItems": 0,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/stageSkip" }
    },
    "decisive_evidence": { "$ref": "#/$defs/decisiveEvidence" },
    "escalation_reason": { "$ref": "#/$defs/escalationReason" },
    "selected_executor": { "$ref": "#/$defs/selectedExecutor" },
    "actual_resource_use": { "$ref": "#/$defs/actualResourceUse" },
    "final_outcome": { "$ref": "#/$defs/taskOutcome" },
    "unnecessary_escalation": { "$ref": "#/$defs/unnecessaryEscalation" },
    "question_closure": { "$ref": "#/$defs/questionClosure" },
    "metrics": { "$ref": "#/$defs/metrics" },
    "authority": { "$ref": "#/$defs/authority" },
    "explicit_unavailable_fields": {
      "type": "array",
      "items": { "$ref": "#/$defs/fieldPath" },
      "uniqueItems": true,
      "maxItems": 256
    },
    "receipt_cid": { "$ref": "#/$defs/cid" }
  },
  "$defs": {
    "cid": {
      "type": "string",
      "minLength": 21,
      "maxLength": 128,
      "pattern": "^b[a-z2-7]{20,}$"
    },
    "gitOid": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nfcString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000]+$"
    },
    "fieldPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[a-z][a-z0-9_.]*$"
    },
    "boundedInt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000000000000
    },
    "positiveInt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000000000000000
    },
    "ratioMillionths": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "unit": {
      "type": "string",
      "enum": [
        "count",
        "tokens",
        "bytes",
        "seconds_millionths",
        "microusd",
        "compute_units",
        "ratio_millionths"
      ]
    },
    "reasonCode": {
      "type": "string",
      "enum": [
        "not_reported",
        "sensor_absent",
        "provider_omitted",
        "collection_failed",
        "permission_denied",
        "hardware_absent",
        "not_applicable",
        "not_yet_measured",
        "fixture_only",
        "deadline_elapsed",
        "not_sealed",
        "not_admitted"
      ]
    },
    "estimatorMethod": {
      "type": "string",
      "enum": [
        "token_price_snapshot",
        "provider_quote",
        "local_compute_model",
        "manual_audit"
      ]
    },
    "identityRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(unavailable|b[a-z2-7]{20,}|sha256:[0-9a-f]{64})$"
    },
    "ladderStage": {
      "type": "string",
      "enum": [
        "exact_current_authoritative_cached_receipt",
        "ast_symbol_dependency_and_impact_analysis",
        "schema_type_static_lint_and_contract_checks",
        "selected_tests",
        "incremental_smt_or_theorem_prover",
        "local_small_specialist_model",
        "local_or_remote_medium_model",
        "remote_strong_or_frontier_model",
        "human_decision"
      ]
    },
    "stageRunReason": {
      "type": "string",
      "enum": [
        "eligible_deterministic_evidence",
        "unresolved_deterministic_evidence",
        "smallest_adequate_executor",
        "human_decision_required"
      ]
    },
    "stageSkipReason": {
      "type": "string",
      "enum": [
        "resolved_by_prior_stage",
        "evidence_unavailable",
        "evidence_ineligible",
        "model_not_required",
        "not_smallest_adequate_executor",
        "required_tier_unavailable",
        "human_gate_preempts_model"
      ]
    },
    "escalationReason": {
      "type": "string",
      "enum": [
        "not_applicable",
        "unresolved_deterministic_evidence",
        "smallest_adequate_executor",
        "human_decision_required",
        "required_tier_unavailable"
      ]
    },
    "executorClass": {
      "type": "string",
      "enum": [
        "deterministic",
        "local_small_model",
        "local_medium_model",
        "remote_frontier_model",
        "human"
      ]
    },
    "modelRoute": {
      "type": "string",
      "enum": [
        "deterministic_only",
        "small_local_model",
        "medium_model",
        "frontier_model",
        "human_review_required"
      ]
    },
    "evidenceKind": {
      "type": "string",
      "enum": [
        "cached_receipt",
        "impact_analysis",
        "static_contract",
        "selected_tests",
        "incremental_proof",
        "model_answer",
        "human_decision"
      ]
    },
    "taskOutcome": {
      "type": "string",
      "enum": [
        "succeeded",
        "failed",
        "retried",
        "rescued",
        "conflicted",
        "human_escalated",
        "quarantined",
        "compensated"
      ]
    },
    "questionClosureStatus": {
      "type": "string",
      "enum": ["not_applicable", "open", "closed"]
    },
    "unavailableEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["truth_state", "reason_code"],
      "properties": {
        "truth_state": { "const": "unavailable" },
        "reason_code": { "$ref": "#/$defs/reasonCode" }
      }
    },
    "simulatedEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["truth_state", "fixture_id", "reason_code"],
      "properties": {
        "truth_state": { "const": "simulated" },
        "fixture_id": { "$ref": "#/$defs/nfcString" },
        "reason_code": { "$ref": "#/$defs/reasonCode" }
      }
    },
    "measuredQuantity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["truth_state", "value", "unit", "sensor_id"],
      "properties": {
        "truth_state": { "const": "measured" },
        "value": { "$ref": "#/$defs/boundedInt" },
        "unit": { "$ref": "#/$defs/unit" },
        "sensor_id": { "$ref": "#/$defs/nfcString" }
      }
    },
    "estimatedQuantity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "truth_state",
        "value",
        "unit",
        "estimator_id",
        "method",
        "price_snapshot_identity"
      ],
      "properties": {
        "truth_state": { "const": "estimated" },
        "value": { "$ref": "#/$defs/boundedInt" },
        "unit": { "$ref": "#/$defs/unit" },
        "estimator_id": { "$ref": "#/$defs/nfcString" },
        "method": { "$ref": "#/$defs/estimatorMethod" },
        "price_snapshot_identity": { "$ref": "#/$defs/identityRef" }
      }
    },
    "quantityObservation": {
      "oneOf": [
        { "$ref": "#/$defs/measuredQuantity" },
        { "$ref": "#/$defs/estimatedQuantity" },
        { "$ref": "#/$defs/unavailableEvidence" },
        { "$ref": "#/$defs/simulatedEvidence" }
      ]
    },
    "observedIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["truth_state", "value"],
      "properties": {
        "truth_state": { "const": "observed" },
        "value": { "$ref": "#/$defs/nfcString" }
      }
    },
    "verifiedIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["truth_state", "value", "verifier_id", "verifier_receipt_cid"],
      "properties": {
        "truth_state": { "const": "verified" },
        "value": { "$ref": "#/$defs/nfcString" },
        "verifier_id": { "$ref": "#/$defs/nfcString" },
        "verifier_receipt_cid": { "$ref": "#/$defs/cid" }
      }
    },
    "identityObservation": {
      "oneOf": [
        { "$ref": "#/$defs/observedIdentity" },
        { "$ref": "#/$defs/verifiedIdentity" },
        { "$ref": "#/$defs/unavailableEvidence" },
        { "$ref": "#/$defs/simulatedEvidence" }
      ]
    },
    "measuredRate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "truth_state",
        "value",
        "unit",
        "numerator",
        "denominator",
        "sensor_id"
      ],
      "properties": {
        "truth_state": { "const": "measured" },
        "value": { "$ref": "#/$defs/ratioMillionths" },
        "unit": { "const": "ratio_millionths" },
        "numerator": { "$ref": "#/$defs/boundedInt" },
        "denominator": { "$ref": "#/$defs/positiveInt" },
        "sensor_id": { "$ref": "#/$defs/nfcString" }
      }
    },
    "rateObservation": {
      "oneOf": [
        { "$ref": "#/$defs/measuredRate" },
        { "$ref": "#/$defs/unavailableEvidence" }
      ]
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "task_cid",
        "objective_id",
        "objective_revision",
        "repository_commit",
        "repository_tree",
        "policy_identity"
      ],
      "properties": {
        "task_id": { "$ref": "#/$defs/nfcString" },
        "task_cid": { "$ref": "#/$defs/cid" },
        "objective_id": { "$ref": "#/$defs/nfcString" },
        "objective_revision": { "$ref": "#/$defs/nfcString" },
        "repository_commit": { "$ref": "#/$defs/gitOid" },
        "repository_tree": { "$ref": "#/$defs/gitOid" },
        "policy_identity": { "$ref": "#/$defs/nfcString" }
      }
    },
    "stageRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "reason", "resolved"],
      "properties": {
        "stage": { "$ref": "#/$defs/ladderStage" },
        "reason": { "$ref": "#/$defs/stageRunReason" },
        "resolved": { "type": "boolean" }
      }
    },
    "stageSkip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "reason"],
      "properties": {
        "stage": { "$ref": "#/$defs/ladderStage" },
        "reason": { "$ref": "#/$defs/stageSkipReason" }
      }
    },
    "decisiveEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "evidence_kind", "evidence_id", "truth_state"],
      "properties": {
        "stage": { "$ref": "#/$defs/ladderStage" },
        "evidence_kind": { "$ref": "#/$defs/evidenceKind" },
        "evidence_id": { "$ref": "#/$defs/nfcString" },
        "truth_state": { "enum": ["observed", "verified"] },
        "verifier_id": { "$ref": "#/$defs/nfcString" },
        "verifier_receipt_cid": { "$ref": "#/$defs/cid" },
        "summary": { "$ref": "#/$defs/nfcString" }
      }
    },
    "selectedExecutor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "executor_class", "route"],
      "properties": {
        "stage": { "$ref": "#/$defs/ladderStage" },
        "executor_class": { "$ref": "#/$defs/executorClass" },
        "route": { "$ref": "#/$defs/modelRoute" }
      }
    },
    "actualResourceUse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_usage_record_id",
        "work_telemetry_record_id",
        "span_id",
        "input_tokens",
        "output_tokens",
        "cached_input_tokens",
        "reasoning_tokens",
        "number_of_calls",
        "provider_reported_charge",
        "cpu_seconds",
        "gpu_seconds",
        "peak_memory",
        "wall_clock_duration",
        "audit_and_verification_overhead"
      ],
      "properties": {
        "provider_usage_record_id": { "$ref": "#/$defs/identityObservation" },
        "work_telemetry_record_id": { "$ref": "#/$defs/identityObservation" },
        "span_id": { "$ref": "#/$defs/identityObservation" },
        "input_tokens": { "$ref": "#/$defs/quantityObservation" },
        "output_tokens": { "$ref": "#/$defs/quantityObservation" },
        "cached_input_tokens": { "$ref": "#/$defs/quantityObservation" },
        "reasoning_tokens": { "$ref": "#/$defs/quantityObservation" },
        "number_of_calls": { "$ref": "#/$defs/quantityObservation" },
        "provider_reported_charge": { "$ref": "#/$defs/quantityObservation" },
        "cpu_seconds": { "$ref": "#/$defs/quantityObservation" },
        "gpu_seconds": { "$ref": "#/$defs/quantityObservation" },
        "peak_memory": { "$ref": "#/$defs/quantityObservation" },
        "wall_clock_duration": { "$ref": "#/$defs/quantityObservation" },
        "audit_and_verification_overhead": { "$ref": "#/$defs/quantityObservation" }
      }
    },
    "observedUnnecessaryEscalation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["truth_state", "unnecessary", "observer_id"],
      "properties": {
        "truth_state": { "const": "observed" },
        "unnecessary": { "type": "boolean" },
        "observer_id": { "$ref": "#/$defs/nfcString" }
      }
    },
    "unnecessaryEscalation": {
      "oneOf": [
        { "$ref": "#/$defs/observedUnnecessaryEscalation" },
        { "$ref": "#/$defs/unavailableEvidence" }
      ]
    },
    "questionClosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "question_id", "closure_evidence"],
      "properties": {
        "status": { "$ref": "#/$defs/questionClosureStatus" },
        "question_id": { "$ref": "#/$defs/identityObservation" },
        "closure_evidence": { "$ref": "#/$defs/identityObservation" }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deterministic_resolution_rate",
        "small_model_resolution_rate",
        "frontier_model_rate",
        "human_rate",
        "escalation_precision",
        "unnecessary_escalation_rate",
        "unresolved_question_closure_rate"
      ],
      "properties": {
        "deterministic_resolution_rate": { "$ref": "#/$defs/rateObservation" },
        "small_model_resolution_rate": { "$ref": "#/$defs/rateObservation" },
        "frontier_model_rate": { "$ref": "#/$defs/rateObservation" },
        "human_rate": { "$ref": "#/$defs/rateObservation" },
        "escalation_precision": { "$ref": "#/$defs/rateObservation" },
        "unnecessary_escalation_rate": { "$ref": "#/$defs/rateObservation" },
        "unresolved_question_closure_rate": { "$ref": "#/$defs/rateObservation" }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_only",
        "validates_patches",
        "promotes_policy",
        "schema_attests_measurement"
      ],
      "properties": {
        "observation_only": { "const": true },
        "validates_patches": { "const": false },
        "promotes_policy": { "const": false },
        "schema_attests_measurement": { "const": false }
      }
    }
  }
}
