{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ipfs_accelerate_py/agent-supervisor/runtime/schemas/task_efficiency_receipt.schema.json",
  "title": "ASEH task efficiency receipt",
  "description": "Closed telemetry contract for one supervisor task. Schema admission does not attest measurements or task completion. Missing metrics remain unavailable and are never numeric zero.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contract_version",
    "authority",
    "attests_measurements",
    "attests_task_completion",
    "identity",
    "model",
    "compute",
    "cost",
    "work",
    "quality",
    "terminal",
    "evidence_state"
  ],
  "properties": {
    "schema": { "const": "aseh/task-efficiency-receipt@1" },
    "contract_version": { "const": 1 },
    "authority": { "const": false },
    "attests_measurements": { "const": false },
    "attests_task_completion": { "const": false },
    "content_id": { "$ref": "#/$defs/Cid" },
    "identity": { "$ref": "#/$defs/Identity" },
    "model": { "$ref": "#/$defs/ModelUse" },
    "compute": { "$ref": "#/$defs/Compute" },
    "cost": { "$ref": "#/$defs/Cost" },
    "work": { "$ref": "#/$defs/Work" },
    "quality": { "$ref": "#/$defs/Quality" },
    "terminal": { "$ref": "#/$defs/Terminal" },
    "evidence_state": { "$ref": "#/$defs/EvidenceStateIndex" }
  },
  "$defs": {
    "Cid": {
      "type": "string",
      "minLength": 21,
      "maxLength": 128,
      "pattern": "^b[a-z2-7]{20,}$"
    },
    "GitObjectId": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "BoundedId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,95}$"
    },
    "BoundedText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "SensorId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "Unit": {
      "type": "string",
      "enum": [
        "tokens",
        "count",
        "bytes",
        "seconds_millionths",
        "microusd",
        "ratio_millionths",
        "compute_units"
      ]
    },
    "UnavailableReason": {
      "type": "string",
      "enum": [
        "sensor-absent",
        "permission-denied",
        "hardware-absent",
        "provider-omitted",
        "collection-failed",
        "not-reported",
        "not-applicable",
        "not-sealed",
        "deadline-elapsed",
        "identity-missing"
      ]
    },
    "NonNegativeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000000000000
    },
    "FieldPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
    },
    "QuantitativeEvidence": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "value", "unit", "sensor_id"],
          "properties": {
            "status": { "const": "measured" },
            "value": { "$ref": "#/$defs/NonNegativeInteger" },
            "unit": { "$ref": "#/$defs/Unit" },
            "sensor_id": { "$ref": "#/$defs/SensorId" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "value", "unit", "estimate_method"],
          "properties": {
            "status": { "const": "estimated" },
            "value": { "$ref": "#/$defs/NonNegativeInteger" },
            "unit": { "$ref": "#/$defs/Unit" },
            "estimate_method": { "$ref": "#/$defs/BoundedId" },
            "price_snapshot_identity": { "$ref": "#/$defs/BoundedText" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason_code", "sensor_id"],
          "properties": {
            "status": { "const": "unavailable" },
            "reason_code": { "$ref": "#/$defs/UnavailableReason" },
            "sensor_id": { "$ref": "#/$defs/SensorId" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "operation", "attempt_id"],
          "properties": {
            "status": { "const": "attempted" },
            "operation": { "$ref": "#/$defs/BoundedId" },
            "attempt_id": { "$ref": "#/$defs/BoundedText" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "value", "unit", "sensor_id"],
          "properties": {
            "status": { "const": "observed" },
            "value": { "$ref": "#/$defs/NonNegativeInteger" },
            "unit": { "$ref": "#/$defs/Unit" },
            "sensor_id": { "$ref": "#/$defs/SensorId" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "value",
            "unit",
            "verifier_identity",
            "verifier_receipt_cid"
          ],
          "properties": {
            "status": { "const": "verified" },
            "value": { "$ref": "#/$defs/NonNegativeInteger" },
            "unit": { "$ref": "#/$defs/Unit" },
            "verifier_identity": { "$ref": "#/$defs/BoundedId" },
            "verifier_receipt_cid": { "$ref": "#/$defs/Cid" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "value", "unit", "fixture_identity"],
          "properties": {
            "status": { "const": "simulated" },
            "value": { "$ref": "#/$defs/NonNegativeInteger" },
            "unit": { "$ref": "#/$defs/Unit" },
            "fixture_identity": { "$ref": "#/$defs/BoundedText" }
          }
        }
      ]
    },
    "IdentityEvidence": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "identity", "sensor_id"],
          "properties": {
            "status": { "const": "observed" },
            "identity": { "$ref": "#/$defs/BoundedText" },
            "sensor_id": { "$ref": "#/$defs/SensorId" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "identity",
            "verifier_identity",
            "verifier_receipt_cid"
          ],
          "properties": {
            "status": { "const": "verified" },
            "identity": { "$ref": "#/$defs/BoundedText" },
            "verifier_identity": { "$ref": "#/$defs/BoundedId" },
            "verifier_receipt_cid": { "$ref": "#/$defs/Cid" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason_code", "sensor_id"],
          "properties": {
            "status": { "const": "unavailable" },
            "reason_code": { "$ref": "#/$defs/UnavailableReason" },
            "sensor_id": { "$ref": "#/$defs/SensorId" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "operation", "attempt_id"],
          "properties": {
            "status": { "const": "attempted" },
            "operation": { "$ref": "#/$defs/BoundedId" },
            "attempt_id": { "$ref": "#/$defs/BoundedText" }
          }
        }
      ]
    },
    "RequestIdEvidence": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "request_ids", "sensor_id"],
          "properties": {
            "status": { "const": "observed" },
            "request_ids": { "$ref": "#/$defs/RequestIds" },
            "sensor_id": { "$ref": "#/$defs/SensorId" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "request_ids",
            "verifier_identity",
            "verifier_receipt_cid"
          ],
          "properties": {
            "status": { "const": "verified" },
            "request_ids": { "$ref": "#/$defs/RequestIds" },
            "verifier_identity": { "$ref": "#/$defs/BoundedId" },
            "verifier_receipt_cid": { "$ref": "#/$defs/Cid" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason_code", "sensor_id"],
          "properties": {
            "status": { "const": "unavailable" },
            "reason_code": { "$ref": "#/$defs/UnavailableReason" },
            "sensor_id": { "$ref": "#/$defs/SensorId" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "operation", "attempt_id"],
          "properties": {
            "status": { "const": "attempted" },
            "operation": { "$ref": "#/$defs/BoundedId" },
            "attempt_id": { "$ref": "#/$defs/BoundedText" }
          }
        }
      ]
    },
    "RequestIds": {
      "type": "array",
      "minItems": 0,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
      }
    },
    "InterfaceSchemaIdentities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-@]{0,255}$"
      }
    },
    "Identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "task_cid",
        "objective_id",
        "objective_revision",
        "repository_commit",
        "repository_tree",
        "policy_identity",
        "context_pack_cid",
        "interface_schema_identities",
        "provider_id",
        "model_id",
        "model_revision"
      ],
      "properties": {
        "task_id": { "$ref": "#/$defs/BoundedId" },
        "task_cid": { "$ref": "#/$defs/Cid" },
        "objective_id": { "$ref": "#/$defs/BoundedId" },
        "objective_revision": { "$ref": "#/$defs/BoundedText" },
        "repository_commit": { "$ref": "#/$defs/GitObjectId" },
        "repository_tree": { "$ref": "#/$defs/GitObjectId" },
        "policy_identity": { "$ref": "#/$defs/BoundedText" },
        "context_pack_cid": { "$ref": "#/$defs/IdentityEvidence" },
        "interface_schema_identities": {
          "$ref": "#/$defs/InterfaceSchemaIdentities"
        },
        "provider_id": { "$ref": "#/$defs/BoundedId" },
        "model_id": { "$ref": "#/$defs/BoundedId" },
        "model_revision": { "$ref": "#/$defs/IdentityEvidence" }
      }
    },
    "ModelClassCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deterministic",
        "local_small_model",
        "local_medium_model",
        "remote_standard_model",
        "remote_frontier_model",
        "human"
      ],
      "properties": {
        "deterministic": { "$ref": "#/$defs/QuantitativeEvidence" },
        "local_small_model": { "$ref": "#/$defs/QuantitativeEvidence" },
        "local_medium_model": { "$ref": "#/$defs/QuantitativeEvidence" },
        "remote_standard_model": { "$ref": "#/$defs/QuantitativeEvidence" },
        "remote_frontier_model": { "$ref": "#/$defs/QuantitativeEvidence" },
        "human": { "$ref": "#/$defs/QuantitativeEvidence" }
      }
    },
    "ModelUse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens",
        "cached_input_tokens",
        "reasoning_tokens",
        "number_of_calls",
        "calls_by_model_class",
        "safe_provider_request_ids",
        "provider_reported_usage"
      ],
      "properties": {
        "input_tokens": { "$ref": "#/$defs/QuantitativeEvidence" },
        "output_tokens": { "$ref": "#/$defs/QuantitativeEvidence" },
        "cached_input_tokens": { "$ref": "#/$defs/QuantitativeEvidence" },
        "reasoning_tokens": { "$ref": "#/$defs/QuantitativeEvidence" },
        "number_of_calls": { "$ref": "#/$defs/QuantitativeEvidence" },
        "calls_by_model_class": { "$ref": "#/$defs/ModelClassCounts" },
        "safe_provider_request_ids": { "$ref": "#/$defs/RequestIdEvidence" },
        "provider_reported_usage": { "$ref": "#/$defs/QuantitativeEvidence" }
      }
    },
    "Compute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu_seconds",
        "gpu_seconds",
        "peak_memory",
        "wall_clock_duration",
        "test_execution_time",
        "prover_execution_time",
        "static_analysis_time",
        "indexing_retrieval_time",
        "bytes_read",
        "bytes_written",
        "process_count",
        "concurrency"
      ],
      "properties": {
        "cpu_seconds": { "$ref": "#/$defs/QuantitativeEvidence" },
        "gpu_seconds": { "$ref": "#/$defs/QuantitativeEvidence" },
        "peak_memory": { "$ref": "#/$defs/QuantitativeEvidence" },
        "wall_clock_duration": { "$ref": "#/$defs/QuantitativeEvidence" },
        "test_execution_time": { "$ref": "#/$defs/QuantitativeEvidence" },
        "prover_execution_time": { "$ref": "#/$defs/QuantitativeEvidence" },
        "static_analysis_time": { "$ref": "#/$defs/QuantitativeEvidence" },
        "indexing_retrieval_time": { "$ref": "#/$defs/QuantitativeEvidence" },
        "bytes_read": { "$ref": "#/$defs/QuantitativeEvidence" },
        "bytes_written": { "$ref": "#/$defs/QuantitativeEvidence" },
        "process_count": { "$ref": "#/$defs/QuantitativeEvidence" },
        "concurrency": { "$ref": "#/$defs/QuantitativeEvidence" }
      }
    },
    "Cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_reported_charge",
        "token_based_estimated_charge",
        "price_snapshot_identity",
        "price_snapshot_timestamp",
        "local_compute_units",
        "audit_and_verification_overhead",
        "cost_per_accepted_patch",
        "cost_per_completed_task"
      ],
      "properties": {
        "provider_reported_charge": { "$ref": "#/$defs/QuantitativeEvidence" },
        "token_based_estimated_charge": { "$ref": "#/$defs/QuantitativeEvidence" },
        "price_snapshot_identity": { "$ref": "#/$defs/IdentityEvidence" },
        "price_snapshot_timestamp": { "$ref": "#/$defs/IdentityEvidence" },
        "local_compute_units": { "$ref": "#/$defs/QuantitativeEvidence" },
        "audit_and_verification_overhead": {
          "$ref": "#/$defs/QuantitativeEvidence"
        },
        "cost_per_accepted_patch": { "$ref": "#/$defs/QuantitativeEvidence" },
        "cost_per_completed_task": { "$ref": "#/$defs/QuantitativeEvidence" }
      }
    },
    "Work": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tests_selected",
        "tests_executed",
        "full_suite_tests",
        "type_static_schema_checks",
        "proof_obligations_selected",
        "proof_obligations_executed",
        "proof_receipts_reused",
        "retries",
        "rescue_attempts",
        "merge_conflicts",
        "manual_recovery",
        "human_interventions"
      ],
      "properties": {
        "tests_selected": { "$ref": "#/$defs/QuantitativeEvidence" },
        "tests_executed": { "$ref": "#/$defs/QuantitativeEvidence" },
        "full_suite_tests": { "$ref": "#/$defs/QuantitativeEvidence" },
        "type_static_schema_checks": { "$ref": "#/$defs/QuantitativeEvidence" },
        "proof_obligations_selected": { "$ref": "#/$defs/QuantitativeEvidence" },
        "proof_obligations_executed": { "$ref": "#/$defs/QuantitativeEvidence" },
        "proof_receipts_reused": { "$ref": "#/$defs/QuantitativeEvidence" },
        "retries": { "$ref": "#/$defs/QuantitativeEvidence" },
        "rescue_attempts": { "$ref": "#/$defs/QuantitativeEvidence" },
        "merge_conflicts": { "$ref": "#/$defs/QuantitativeEvidence" },
        "manual_recovery": { "$ref": "#/$defs/QuantitativeEvidence" },
        "human_interventions": { "$ref": "#/$defs/QuantitativeEvidence" }
      }
    },
    "Quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted_patch_quality",
        "quality_adjusted_cost",
        "false_positives",
        "false_negatives",
        "selected_test_false_negatives",
        "controlled_critical_omissions",
        "escaped_critical_seeded_defects"
      ],
      "properties": {
        "accepted_patch_quality": { "$ref": "#/$defs/QuantitativeEvidence" },
        "quality_adjusted_cost": { "$ref": "#/$defs/QuantitativeEvidence" },
        "false_positives": { "$ref": "#/$defs/QuantitativeEvidence" },
        "false_negatives": { "$ref": "#/$defs/QuantitativeEvidence" },
        "selected_test_false_negatives": {
          "$ref": "#/$defs/QuantitativeEvidence"
        },
        "controlled_critical_omissions": {
          "$ref": "#/$defs/QuantitativeEvidence"
        },
        "escaped_critical_seeded_defects": {
          "$ref": "#/$defs/QuantitativeEvidence"
        }
      }
    },
    "Terminal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "final_task_outcome",
        "validation_result",
        "patch_disposition",
        "population_kind"
      ],
      "properties": {
        "final_task_outcome": {
          "type": "string",
          "enum": [
            "successful",
            "failed",
            "cancelled",
            "conflicted",
            "quarantined",
            "compensated",
            "unavailable"
          ]
        },
        "validation_result": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "skipped",
            "not_required",
            "unavailable"
          ]
        },
        "patch_disposition": {
          "type": "string",
          "enum": [
            "accepted",
            "rejected",
            "quarantined",
            "reverted",
            "unavailable"
          ]
        },
        "population_kind": {
          "type": "string",
          "enum": [
            "hermetic",
            "historical_replay",
            "live",
            "unavailable"
          ]
        }
      }
    },
    "EvidenceStateIndex": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measured",
        "estimated",
        "unavailable",
        "attempted",
        "observed",
        "verified",
        "simulated"
      ],
      "properties": {
        "measured": { "$ref": "#/$defs/FieldPathList" },
        "estimated": { "$ref": "#/$defs/FieldPathList" },
        "unavailable": { "$ref": "#/$defs/FieldPathList" },
        "attempted": { "$ref": "#/$defs/FieldPathList" },
        "observed": { "$ref": "#/$defs/FieldPathList" },
        "verified": { "$ref": "#/$defs/FieldPathList" },
        "simulated": { "$ref": "#/$defs/FieldPathList" }
      }
    },
    "FieldPathList": {
      "type": "array",
      "minItems": 0,
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/FieldPath" }
    }
  }
}
