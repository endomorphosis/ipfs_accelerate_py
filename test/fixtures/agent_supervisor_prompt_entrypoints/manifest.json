  "promotion_gates": {
    "success": [
      {
        "id": "single-repository-prompt-only-healthy-rate",
        "metric": "eligible invocations reaching an admitted, materialized, healthy or explicitly healthy-degraded run",
        "operator": ">=",
        "threshold": 0.95,
        "unit": "ratio",
        "minimum_samples_per_transport": 30
      },
      {
        "id": "deterministic-resolution-replay-rate",
        "metric": "unchanged evidence replays producing the same canonical target resolution receipt",
        "operator": "==",
        "threshold": 1.0,
        "unit": "ratio",
        "minimum_replays_per_fixture": 10
      },
      {
        "id": "expert-request-compatibility-rate",
        "metric": "unchanged expert requests retaining canonical results and exit behavior",
        "operator": "==",
        "threshold": 1.0,
        "unit": "ratio",
        "minimum_samples": 100
      },
      {
        "id": "typed-provider-fallback-receipt-rate",
        "metric": "Codex fallback dispatches preceded by a complete typed Grok fallback receipt",
