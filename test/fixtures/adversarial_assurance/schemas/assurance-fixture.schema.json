{
  "$id": "https://ipfs-accelerate.dev/schemas/aae/assurance-fixture@1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "partition": {
            "const": "held_out"
          }
        },
        "required": [
          "partition"
        ]
      },
      "then": {
        "properties": {
          "used_for_candidate_generation": {
            "const": false
          }
        }
      }
    }
  ],
  "properties": {
    "bounded_oracle": {
      "additionalProperties": false,
      "properties": {
        "bounds": {
          "additionalProperties": false,
          "properties": {
            "max_depth": {
              "maximum": 10000,
              "minimum": 1,
              "type": "integer"
            },
            "max_steps": {
              "maximum": 100000,
              "minimum": 1,
              "type": "integer"
            },
            "timeout_ms": {
              "maximum": 3600000,
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "max_steps",
            "max_depth",
            "timeout_ms"
          ],
          "type": "object"
        },
        "expected_outcome": {
          "enum": [
            "killed",
            "survived_selected",
            "survived_full",
            "invalid",
            "equivalent_review"
          ],
          "type": "string"
        },
        "fail_closed": {
          "type": "boolean"
        },
        "kill_mechanisms": {
          "items": {
            "pattern": "^[a-z][a-z0-9_.:/+-]{0,127}$",
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "observation_points": {
          "items": {
            "pattern": "^[a-z][a-z0-9_.:/+-]{0,127}$",
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "oracle_cid": {
          "maxLength": 128,
          "minLength": 8,
          "pattern": "^b[a-z2-7]+$",
          "type": "string"
        },
        "oracle_id": {
          "pattern": "^[a-z][a-z0-9_.:/+-]{0,127}$",
          "type": "string"
        },
        "schema": {
          "const": "aae/bounded-oracle@1"
        }
      },
      "required": [
        "schema",
        "oracle_id",
        "expected_outcome",
        "kill_mechanisms",
        "bounds",
        "observation_points",
        "fail_closed",
        "oracle_cid"
      ],
      "type": "object"
    },
    "campaign": {
      "enum": [
        "security",
        "semantic_compression",
        "zk_incremental_seal",
        "distributed_storage_crash",
        "vacuity_gui"
      ],
      "type": "string"
    },
    "campaign_bundle": {
      "pattern": "^[a-z][a-z0-9_.:/+-]{0,127}$",
      "type": "string"
    },
    "critical": {
      "type": "boolean"
    },
    "expected_detector": {
      "additionalProperties": false,
      "properties": {
        "detector_cid": {
          "maxLength": 128,
          "minLength": 8,
          "pattern": "^b[a-z2-7]+$",
          "type": "string"
        },
        "detector_id": {
          "pattern": "^[a-z][a-z0-9_.:/+-]{0,127}$",
          "type": "string"
        },
        "detector_kind": {
          "enum": [
            "static_rule",
            "type_check",
            "unit_test",
            "integration_test",
            "property_test",
            "formal_obligation",
            "policy_rule",
            "runtime_invariant",
            "full_suite",
            "incremental_seal",
            "human_review"
          ],
          "type": "string"
        },
        "detector_revision": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "expected_terminal_status": {
          "enum": [
            "complete",
            "rejected",
            "invalid",
            "stale",
            "inconclusive",
            "evaluation_failed",
            "human_review_required",
            "unavailable",
            "cancelled",
            "simulated"
          ],
          "type": "string"
        },
        "observation_rationale": {
          "maxLength": 16384,
          "minLength": 1,
          "type": "string"
        },
        "schema": {
          "const": "aae/expected-detector@1"
        },
        "strength": {
          "enum": [
            "required",
            "optional"
          ],
          "type": "string"
        },
        "violated_claim": {
          "pattern": "^[a-z][a-z0-9_.:/+-]{0,127}$",
          "type": "string"
        }
      },
      "required": [
        "schema",
        "detector_id",
        "detector_revision",
        "detector_kind",
        "strength",
        "expected_terminal_status",
        "violated_claim",
        "observation_rationale",
        "detector_cid"
      ],
      "type": "object"
    },
    "fixture_cid": {
      "maxLength": 128,
      "minLength": 8,
      "pattern": "^b[a-z2-7]+$",
      "type": "string"
    },
    "fixture_id": {
      "pattern": "^[a-z][a-z0-9_.:/+-]{0,127}$",
      "type": "string"
    },
    "notes": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "maxLength": 16384,
          "minLength": 1,
          "type": "string"
        }
      ]
    },
    "operator": {
      "additionalProperties": false,
      "properties": {
        "operator_class": {
          "enum": [
            "control_flow",
            "data_schema",
            "interface_contract",
            "side_effect",
            "error_retry",
            "authorization_policy",
            "state_distributed",
            "storage_durability",
            "test_proof",
            "semantic_compression",
            "gui_action_binding"
          ],
          "type": "string"
        },
        "operator_id": {
          "pattern": "^[a-z][a-z0-9_.:/+-]{0,127}$",
          "type": "string"
        },
        "operator_version": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "operator_id",
        "operator_version",
        "operator_class"
      ],
      "type": "object"
    },
    "partition": {
      "enum": [
        "diagnosis",
        "development",
        "held_out"
      ],
      "type": "string"
    },
    "recipe_cid": {
      "maxLength": 128,
      "minLength": 8,
      "pattern": "^b[a-z2-7]+$",
      "type": "string"
    },
    "relatedness_key": {
      "pattern": "^[a-z][a-z0-9_.:/+-]{0,127}$",
      "type": "string"
    },
    "requirement_provenance": {
      "additionalProperties": false,
      "properties": {
        "intended_behavior": {
          "maxLength": 16384,
          "minLength": 1,
          "type": "string"
        },
        "notes": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "maxLength": 16384,
              "minLength": 1,
              "type": "string"
            }
          ]
        },
        "provenance_cid": {
          "maxLength": 128,
          "minLength": 8,
          "pattern": "^b[a-z2-7]+$",
          "type": "string"
        },
        "requirement_cid": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "maxLength": 128,
              "minLength": 8,
              "pattern": "^b[a-z2-7]+$",
              "type": "string"
            }
          ]
        },
        "requirement_id": {
          "pattern": "^[a-z][a-z0-9_.:/+-]{0,127}$",
          "type": "string"
        },
        "schema": {
          "const": "ipfs-datasets.software-contracts.adversarial-assurance-requirement-provenance@1"
        },
        "source_id": {
          "pattern": "^[a-z][a-z0-9_.:/+-]{0,127}$",
          "type": "string"
        },
        "source_path": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "maxLength": 16384,
              "minLength": 1,
              "type": "string"
            }
          ]
        }
      },
      "required": [
        "schema",
        "requirement_id",
        "intended_behavior",
        "source_id",
        "requirement_cid",
        "source_path",
        "notes",
        "provenance_cid"
      ],
      "type": "object"
    },
    "risk": {
      "enum": [
        "critical_security",
        "authorization",
        "durability",
        "financial_legal",
        "distributed_transition",
        "proof_receipt_trust",
        "critical_invariant",
        "high",
        "medium",
        "local_bug",
        "low"
      ],
      "type": "string"
    },
    "scenario": {
      "pattern": "^[a-z][a-z0-9_.:/+-]{0,127}$",
      "type": "string"
    },
    "schema": {
      "const": "aae/assurance-fixture@1"
    },
    "target_id": {
      "pattern": "^[a-z][a-z0-9_.:/+-]{0,127}$",
      "type": "string"
    },
    "used_for_candidate_generation": {
      "type": "boolean"
    }
  },
  "required": [
    "schema",
    "fixture_id",
    "campaign",
    "campaign_bundle",
    "scenario",
    "partition",
    "risk",
    "operator",
    "requirement_provenance",
    "expected_detector",
    "bounded_oracle",
    "relatedness_key",
    "target_id",
    "used_for_candidate_generation",
    "critical",
    "notes",
    "fixture_cid",
    "recipe_cid"
  ],
  "title": "AAE assurance fixture record",
  "type": "object"
}
